<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:contentPadding="14dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/sign_apk_ic"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_apk_color_48dp" />

                        <TextView
                            android:id="@+id/sign_apk_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/myprojects_export_project_button_sign_apk"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            tools:ignore="RtlSymmetry" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/sign_apk_button"
                        style="@style/Widget.Material3Expressive.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/myprojects_export_project_button_sign_apk" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/sign_apk_output_stage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Replaced complex layout with a simple TextInputLayout for consistency -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:background="?attr/colorSurfaceContainerHighest"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="12dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_folder_48dp"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/sign_apk_output_path"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:ellipsize="start"
                                    android:singleLine="true"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    tools:text="/storage/emulated/0/Sketchware/signed_apk/my_app.apk" />
                            </LinearLayout>

                            <!-- This entire section for path was replaced by the layout above
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_round_light_grey"
                                android:orientation="horizontal">

                                <HorizontalScrollView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">

                                    <TextView
                                        android:id="@+id/sign_apk_output_path"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:gravity="center_vertical"
                                        android:lines="1"
                                        android:padding="8dp"
                                        android:textSize="13sp" />
                                </HorizontalScrollView>
                            </LinearLayout> -->
                        </LinearLayout>

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/sign_apk_loading_anim"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            app:lottie_autoPlay="false"
                            app:lottie_fileName="anim/loading_simple_gray.json"
                            app:lottie_loop="true" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:contentPadding="14dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/export_source_ic"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/android_icon" />

                        <TextView
                            android:id="@+id/export_source_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/myprojects_export_project_title_export_src"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            tools:ignore="RtlSymmetry" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/export_source_button"
                        style="@style/Widget.Material3Expressive.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/myprojects_export_project_button_export_src" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/export_source_output_stage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Replaced complex layout with a simple TextInputLayout for consistency -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:background="?attr/colorSurfaceContainerHighest"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="12dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_folder_48dp"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/export_source_output_path"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:ellipsize="start"
                                    android:singleLine="true"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    tools:text="/storage/emulated/0/Sketchware/exported/123.zip" />
                            </LinearLayout>

                            <!-- This entire section for path was replaced by the layout above
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_round_light_grey"
                                android:orientation="horizontal">

                                <HorizontalScrollView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">

                                    <TextView
                                        android:id="@+id/export_source_output_path"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:gravity="center_vertical"
                                        android:lines="1"
                                        android:padding="8dp"
                                        android:textSize="13sp" />
                                </HorizontalScrollView>
                            </LinearLayout> -->

                            <!-- Using a ButtonBarLayout for better alignment of actions -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingVertical="10dp">

                                <Button
                                    android:id="@+id/export_source_open_folder_button"
                                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    android:text="@string/design_drawer_menu_title_source_code" />

                                <Button
                                    android:id="@+id/export_source_send_button"
                                    style="@style/Widget.Material3Expressive.Button"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:text="@string/myprojects_export_project_button_send_src_zip" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- The loading animation remains unchanged -->
                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/export_source_loading_anim"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            app:lottie_autoPlay="false"
                            app:lottie_fileName="anim/loading_simple_gray.json"
                            app:lottie_loop="true" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:contentPadding="14dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/export_aab_ic"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/open_box_48" />

                        <TextView
                            android:id="@+id/export_aab_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Export AAB (Android App Bundle)"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            tools:ignore="RtlSymmetry" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/export_aab_button"
                        style="?attr/materialButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Export AAB" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>