<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">

    <io.github.rosemoe.sora.widget.CodeEditor
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="?attr/actionBarSize"
        tools:ignore="MissingClass" />

    <!-- 2. AppBarLayout (Posicionada no Fundo) -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurfaceContainerLowest">

        <!-- Usamos um MaterialToolbar como o conteúdo da barra inferior. -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurfaceContainerLowest"
            app:contentInsetStartWithNavigation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Spinner M3 para a lista de arquivos (Ocupa 1/3) -->
                <Spinner
                    android:id="@+id/files_list_spinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:spinnerMode="dropdown"
                    app:popupTheme="@style/ThemeOverlay.Material3.Button" />

                <!-- Separador (Opcional, para melhor espaçamento) -->
                <Space
                    android:layout_width="16dp"
                    android:layout_height="match_parent" />

                <!-- Botão de ícone M3 (Alinhado à direita) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/change_font_size"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Mudar tamanho da fonte"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    app:icon="@drawable/ic_mtrl_formattext"
                    app:iconTint="?attr/colorOnSurface" />
            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
