<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="mod.loddv.dev.manager.ManageStringActivity">
    <item
        android:id="@+id/action_search"
        android:icon="@drawable/ic_mtrl_search"
        android:title="Search"
        app:actionViewClass="androidx.appcompat.widget.SearchView"
        app:showAsAction="always|collapseActionView"
        tools:ignore="AlwaysShowAction" />
    <item
        android:id="@+id/action_search_scope"
        android:icon="@drawable/ic_mtrl_filter"
        android:title="Search in"
        android:visible="false"
        app:showAsAction="always"
        tools:ignore="AlwaysShowAction">
        <menu>
            <group
                android:checkableBehavior="single">
                <item
                    android:id="@+id/search_scope_all"
                    android:checked="true"
                    android:title="All" />
                <item
                    android:id="@+id/search_scope_keys"
                    android:title="Keys" />
                <item
                    android:id="@+id/search_scope_values"
                    android:title="Values" />
            </group>
        </menu>
    </item>
</menu>
