    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="android_settings_category"
        app:singleLineTitle="true"
        app:title="⚙️ Configurações do Projeto Android">

        <ListPreference
            app:defaultValue="34"
            app:dialogTitle="Selecione a versão do Compile SDK"
            app:entries="@array/sdk_versions_names"
            app:entryValues="@array/sdk_versions_values"
            app:key="pref_compile_sdk_version"
            app:summary="Versão do SDK para compilação."
            app:title="Compile SDK Version" />
        <ListPreference
            app:defaultValue="21"
            app:dialogTitle="Selecione a versão do Min SDK"
            app:entries="@array/sdk_versions_names"
            app:entryValues="@array/sdk_versions_values"
            app:key="pref_min_sdk_version"
            app:summary="Versão mínima do SDK suportada (mínimo: 21)."
            app:title="Min SDK Version" />

        <ListPreference
            app:defaultValue="34"
            app:dialogTitle="Selecione a versão do Target SDK"
            app:entries="@array/sdk_versions_names"
            app:entryValues="@array/sdk_versions_values"
            app:key="pref_target_sdk_version"
            app:summary="Versão do SDK para qual o aplicativo foi testado."
            app:title="Target SDK Version" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_enable_view_binding"
            app:summaryOff="View Binding está desabilitado."
            app:summaryOn="View Binding está habilitado no build.gradle."
            app:title="Habilitar View Binding" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_use_http_legacy"
            app:summary="Inclui 'useLibrary org.apache.http.legacy'."
            app:title="Usar Biblioteca HTTP Legacy" />

    </PreferenceCategory>

    ---

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="libraries_category"
        app:singleLineTitle="true"
        app:title="📚 Bibliotecas e Dependências">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_use_appcompat_material"
            app:summary="Inclui 'androidx.appcompat:appcompat' e 'com.google.android.material:material'."
            app:title="Usar AppCompat e Material Design" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_enable_firebase_bom"
            app:summary="Necessário para todas as dependências do Firebase."
            app:title="Habilitar Plataforma Firebase (BOM)" />

        <PreferenceCategory
            app:dependency="pref_enable_firebase_bom"
            app:iconSpaceReserved="false"
            app:key="firebase_services_category"
            app:singleLineTitle="true"
            app:title="Firebase Services">

            <SwitchPreferenceCompat
                app:defaultValue="false"
                app:key="pref_use_firebase_auth"
                app:title="Firebase Authentication" />

            <SwitchPreferenceCompat
                app:defaultValue="false"
                app:key="pref_use_firebase_database"
                app:title="Firebase Realtime Database" />

            <SwitchPreferenceCompat
                app:defaultValue="false"
                app:key="pref_use_firebase_storage"
                app:title="Firebase Storage" />

            <SwitchPreferenceCompat
                app:defaultValue="false"
                app:key="pref_use_firebase_messaging"
                app:title="Firebase Cloud Messaging (FCM)" />
        </PreferenceCategory>

        <PreferenceCategory
            app:iconSpaceReserved="false"
            app:key="additional_libraries_category"
            app:singleLineTitle="true"
            app:title="Bibliotecas Adicionais">

            <SwitchPreferenceCompat
                app:defaultValue="false"
                app:key="pref_use_admob"
                app:title="Google AdMob (Play Services Ads)" />

            <SwitchPreferenceCompat
                app:defaultValue="false"
                app:key="pref_use_maps"
                app:title="Google Maps (Play Services Maps)" />

            <SwitchPreferenceCompat
                app:defaultValue="false"
                app:key="pref_use_glide"
                app:title="Glide (Carregamento de Imagens)" />

            <SwitchPreferenceCompat
                app:defaultValue="false"
                app:key="pref_use_gson"
                app:title="Gson (JSON Parser)" />

            <SwitchPreferenceCompat
                app:defaultValue="false"
                app:key="pref_use_okhttp"
                app:title="OkHttp3" />

            <Preference
                app:key="pref_manage_local_libraries"
                app:summary="Adicionar ou remover dependências customizadas do arquivo local_library."
                app:title="Gerenciar Dependências Locais" />
        </PreferenceCategory>

    </PreferenceCategory>

</PreferenceScreen>